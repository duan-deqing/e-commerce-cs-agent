APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# auto = mock when no API key
MOCK_LLM=auto

# Tavily web search (optional)
TAVILY_API_KEY=

# RAG
CHROMA_PERSIST_DIR=.chroma
RAG_TOP_K=15
RAG_RERANK_TOP_N=5
RAG_SCORE_THRESHOLD=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Business / risk
REFUND_RISK_THRESHOLD=2000
CONTEXT_MAX_TURNS=12
TOOL_TIMEOUT_S=3.0
TOOL_MAX_RETRIES=2

# Knowledge
KNOWLEDGE_DIR=knowledge
DATA_DIR=data
