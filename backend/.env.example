APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# 配置后要求请求头 X-API-Key；留空关闭鉴权
API_KEY=
# CORS 逗号分隔；留空则 dev 用 *，非 dev 为空
CORS_ORIGINS=
# 会话 TTL（秒）与最大条数
SESSION_TTL_SECONDS=1800
SESSION_MAX_SIZE=5000

# OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# DashScope 示例：EMBEDDING_MODEL=text-embedding-v3（勿用 qwen 对话模型名）

# auto = mock when no API key
MOCK_LLM=auto

# Thinking-model switch (DashScope qwen3 / DeepSeek-R1 etc.): auto | true | false
# false sends enable_thinking=false -> much lower TTFT (also speeds up intent classify)
LLM_ENABLE_THINKING=auto

# Tavily web search (optional)
TAVILY_API_KEY=

# RAG
CHROMA_PERSIST_DIR=.chroma
RAG_TOP_K=15
RAG_RERANK_TOP_N=5
RAG_SCORE_THRESHOLD=0.35
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Business / risk
REFUND_RISK_THRESHOLD=2000
CONTEXT_MAX_TURNS=12
TOOL_TIMEOUT_S=3.0
TOOL_MAX_RETRIES=2

# Knowledge / DB
KNOWLEDGE_DIR=knowledge
DATA_DIR=data
DB_PATH=data/app.db
