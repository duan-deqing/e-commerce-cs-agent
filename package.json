{
  "name": "ecommerce-cs-agent",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm run api\" \"pnpm run web\"",
    "api": "powershell -ExecutionPolicy Bypass -File ./scripts/start-backend.ps1",
    "web": "pnpm --dir frontend dev",
    "dev:ps1": "powershell -ExecutionPolicy Bypass -File ./run-dev.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
